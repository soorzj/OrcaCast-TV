{
  "name": "orcacast-tv",
  "productName": "OrcaCast TV",
  "version": "1.3.0",
  "description": "OrcaCast TV - TV-style launcher with phone remote",
  "main": "main.js",
  "scripts": { "start": "electron .", "dist": "electron-builder --win nsis portable" },
  "dependencies": { "hls.js": "^1.5.0", "bonjour-service": "^1.3.0", "qrcode": "^1.5.4", "ws": "^8.18.0" },
  "devDependencies": { "electron": "^33.0.0", "electron-builder": "^25.1.8" },
  "build": {
    "appId": "com.orcacast.tv", "productName": "OrcaCast TV",
    "files": ["main.js", "index.html", "remote.html", "osd.html", "player.html"],
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "perMachine": true, "allowToChangeInstallationDirectory": true, "include": "installer.nsh" }
  }
}
